# The site root only indexes index.php; this folder is a static page.
DirectoryIndex index.html

# The root caches CSS/JS for a year because it versions its URLs (?v=mtime).
# These files aren't versioned, so keep the cache short enough for edits to show up.
<IfModule mod_expires.c>
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tools(/|$) - [F,L]
</IfModule>
